  url      = env("postgresql://postgres.eeucibagtlkpgfbjmbgw:Nkumar@2710#2002@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true")
  directUrl = env("postgresql://postgres:Nkumar@2710#2002@db.eeucibagtlkpgfbjmbgw.supabase.co:5432/postgres")
